{
  "name": "momo-pos",
  "version": "1.0.0",
  "description": "موموـ POS — Offline Restaurant Management System",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --win --config",
    "package:portable": "npm run build && electron-builder --win portable --config",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.momo.pos",
    "productName": "موموـ POS",
    "copyright": "Copyright © 2024 Momo",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "src/main/db/migrations",
        "to": "migrations",
        "filter": ["*.sql"]
      },
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icons/momo.ico",
      "requestedExecutionLevel": "asCurrentUser"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Momo POS",
      "installerIcon": "assets/icons/momo.ico",
      "uninstallerIcon": "assets/icons/momo.ico",
      "artifactName": "MomoPOS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MomoPOS-Portable-${version}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ]
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "dayjs": "^1.11.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^30.1.2",
    "electron-builder": "^25.0.5",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.3",
    "vite": "^6.4.2"
  }
}
